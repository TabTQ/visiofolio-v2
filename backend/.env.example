# Database Configuration
# Copy this file to .env and update with your actual values

# PostgreSQL Database URL
# Format: jdbc:postgresql://<host>:<port>/<database_name>
# Examples:
#   Local: jdbc:postgresql://localhost:5432/portfolio_db
#   Remote: jdbc:postgresql://192.168.1.100:5432/portfolio_db
#   Cloud: jdbc:postgresql://mydb.abc123.us-east-1.rds.amazonaws.com:5432/portfolio_db
DB_URL=jdbc:postgresql://localhost:5432/portfolio_db

# Database Credentials
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Server Configuration (optional)
SERVER_PORT=8080

# Environment (optional)
# Options: dev, prod
SPRING_PROFILES_ACTIVE=dev
